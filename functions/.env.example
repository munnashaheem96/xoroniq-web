# ==============================================================================
# XORONIQ CAR CARE - BACKEND ENVIRONMENT CONFIGURATION (.env)
# Rename this file to .env and fill in the values for local and Cloud Functions runtime.
# NEVER commit the actual .env file with production secrets to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RAZORPAY GATEWAY CREDENTIALS (SERVER-SIDE ONLY)
# Obtain from: https://dashboard.razorpay.com/app/keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------------------------------------------
# 2. RAZORPAY WEBHOOK SECRET
# Obtain when configuring webhook in Razorpay Dashboard -> Settings -> Webhooks
# Webhook URL: https://<region>-marketing-website-45737.cloudfunctions.net/razorpayWebhook
# Active Events: payment.captured, order.paid
# ------------------------------------------------------------------------------
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 3. AUTOMATED EMAIL SENDER (GMAIL SMTP / APP PASSWORD)
# Sender Email Address: xoroniq@gmail.com
# To generate EMAIL_APP_PASSWORD:
#   1. Sign in to xoroniq@gmail.com
#   2. Go to: https://myaccount.google.com/security
#   3. Enable 2-Step Verification (if not already enabled)
#   4. Search for "App Passwords"
#   5. Create an App password (e.g. Name: "XORONIQ Store Order Emails")
#   6. Copy the generated 16-character password and paste below
# ------------------------------------------------------------------------------
EMAIL_USER=xoroniq@gmail.com
EMAIL_APP_PASSWORD=your_gmail_16_char_app_password

# ------------------------------------------------------------------------------
# 4. XORONIQ 3 BUSINESS PARTNER NOTIFICATION RECIPIENTS
# Every confirmed order will be automatically dispatched to all 3 partners.
# Replace with actual partner email addresses.
# ------------------------------------------------------------------------------
PARTNER_EMAIL_1=partner1@example.com
PARTNER_EMAIL_2=partner2@example.com
PARTNER_EMAIL_3=partner3@example.com

# ------------------------------------------------------------------------------
# 5. ADMIN AUTHENTICATION SECRET
# Used to authorize administrative manual email resend requests from the Admin Panel.
# ------------------------------------------------------------------------------
ADMIN_API_SECRET=your_secure_admin_api_secret_key_here

# ------------------------------------------------------------------------------
# 6. APPLICATION URLS
# ------------------------------------------------------------------------------
FRONTEND_URL=https://xoroniq.store
PORT=5001
