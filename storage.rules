rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthorizedAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email.lower() in [
          'munnashaheemperinchikkal@gmail.com',
          'sanahuhaq0@gmail.com',
          'tobesuccess96@gmail.com',
          'xoroniq@gmail.com',
          'admin@xoroniq.com'
        ] ||
        request.auth.token.email.matches('.*@xoroniq\\.store$') ||
        request.auth.token.email.matches('.*@xoroniq\\.com$')
      );
    }

    // Product Images: Public read, Admin write
    match /products/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAuthorizedAdmin();
    }

    // User profile images
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny write
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
  }
}
